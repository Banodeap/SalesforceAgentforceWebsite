# Salesforce Setup > My Domain > Current My Domain URL (NOT lightning.force.com)
SF_MY_DOMAIN=https://YOUR_DOMAIN.my.salesforce.com

# External Client App consumer key and consumer secret. Keep these server-side.
SF_CLIENT_ID=PASTE_CONSUMER_KEY_HERE
SF_CLIENT_SECRET=PASTE_CONSUMER_SECRET_HERE

# Agent ID from Salesforce's Agent API documentation.
SF_AGENT_ID=PASTE_AGENT_ID_HERE

# Normal Salesforce org: api.salesforce.com
# Government Cloud: api.gov.salesforce.com
SF_AGENT_API_HOST=api.salesforce.com

# For the client-credentials flow, Salesforce's guide commonly uses true.
SF_BYPASS_USER=true

PORT=5000
SESSION_TTL_SECONDS=1800
